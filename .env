; Configuracion de Supabase - PostgreSQL via PDO
; DATA_DRIVER debe ser "supabase" para activar la conexion PDO a Supabase
DATA_DRIVER=supabase

; Credenciales PDO para PostgreSQL de Supabase
SUPABASE_DB_HOST=db.lomxtxtdjqxcrpujwqxn.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS="ficha de inscricion"
SUPABASE_DB_SSLMODE=require

; Entorno: local o production
APP_ENV=local
DEBUG=false
