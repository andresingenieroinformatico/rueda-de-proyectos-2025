# Configuración de Supabase (PostgreSQL via PDO)
# Activa el backend Supabase (debe ser "supabase", no "pdo" ni "mysql")
DATA_DRIVER=supabase

# Credenciales PDO para PostgreSQL de Supabase
# config.php las busca como SUPABASE_DB_* primero
SUPABASE_DB_HOST="db.lomxtxtdjqxcrpujwqxn.supabase.co"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="postgres"
SUPABASE_DB_PASS="ficha de inscrición"
SUPABASE_DB_SSLMODE="require"

# Entorno (production = Railway | local = desarrollo)
APP_ENV=local
DEBUG=false
